{
  "name": "systemforge-web",
  "version": "0.0.0",
  "private": true,
  "description": "SystemForge Web - React framework for multi-tenant SaaS applications",
  "repository": {
    "type": "git",
    "url": "https://github.com/plexusone/systemforge-web.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "turbo run build && pnpm run check:exports && pnpm run check:dist-paths",
    "check:exports": "node scripts/check-exports.mjs",
    "check:dist-paths": "node scripts/dist-paths.mjs check",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.1",
    "turbo": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=9.0.0"
  }
}
