{
  "name": "@plexusone/pages",
  "version": "0.2.0",
  "description": "Standard page components for SystemForge applications",
  "homepage": "https://plexusone.github.io/systemforge-web/packages/pages/",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "@plexusone/auth": "workspace:^"
  },
  "devDependencies": {
    "@plexusone/auth": "workspace:*",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "systemforge",
    "pages",
    "login",
    "error",
    "settings"
  ],
  "author": "SystemForge Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plexusone/systemforge-web.git",
    "directory": "packages/pages"
  },
  "bugs": {
    "url": "https://github.com/plexusone/systemforge-web/issues"
  }
}
