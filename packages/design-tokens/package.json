{
  "name": "@plexusone/design-tokens",
  "version": "0.2.1",
  "description": "Design tokens and CSS custom properties for SystemForge applications",
  "homepage": "https://plexusone.github.io/systemforge-web/packages/design-tokens/",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && pnpm run build:css",
    "build:css": "node scripts/generate-css.js",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "systemforge",
    "design-tokens",
    "css",
    "theme"
  ],
  "author": "SystemForge Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plexusone/systemforge-web.git",
    "directory": "packages/design-tokens"
  },
  "bugs": {
    "url": "https://github.com/plexusone/systemforge-web/issues"
  }
}
