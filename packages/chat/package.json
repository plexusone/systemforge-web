{
  "name": "@plexusone/chat",
  "version": "0.3.0",
  "description": "Chat UI components for SystemForge applications",
  "homepage": "https://plexusone.github.io/systemforge-web/packages/chat/",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build && node ../../scripts/dist-paths.mjs check .",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.32",
    "@ai-sdk/react": "^4.0.163",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "react",
    "chat",
    "assistant",
    "ai",
    "systemforge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plexusone/systemforge-web.git",
    "directory": "packages/chat"
  },
  "bugs": {
    "url": "https://github.com/plexusone/systemforge-web/issues"
  }
}
