{
  "name": "@plexusone/shell",
  "version": "0.3.0",
  "description": "Application shell components for SystemForge applications",
  "homepage": "https://plexusone.github.io/systemforge-web/packages/shell/",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build && node ../../scripts/dist-paths.mjs check .",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "@plexusone/auth": "workspace:^",
    "@plexusone/tenant": "workspace:^",
    "@plexusone/ui": "workspace:^"
  },
  "devDependencies": {
    "@plexusone/auth": "workspace:*",
    "@plexusone/tenant": "workspace:*",
    "@plexusone/ui": "workspace:*",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "systemforge",
    "shell",
    "layout",
    "navigation"
  ],
  "author": "SystemForge Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plexusone/systemforge-web.git",
    "directory": "packages/shell"
  },
  "bugs": {
    "url": "https://github.com/plexusone/systemforge-web/issues"
  }
}
